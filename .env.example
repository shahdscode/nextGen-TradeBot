# ── NextGen TradeBot — environment variables ──────────────────────────────────
# Copy this file to .env and fill in your values before running the backend.
# The backend loads .env automatically via pydantic-settings.
#
# Generate a secure JWT secret:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (default):
#   DATABASE_URL=sqlite:///./data/finrl.db
#
# Supabase (recommended — use Transaction pooler, port 6543):
#   DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Supabase direct connection (migrations / one-off scripts only, port 5432):
#   DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
#
# Get the URI from: Supabase Dashboard → Project Settings → Database → Connection string
DATABASE_URL=sqlite:///./data/finrl.db
DATABASE_SSL_MODE=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── Redis (required for Celery async ML tasks) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
# !! CRITICAL: replace this before any public deployment !!
# The backend will print a loud warning on startup if this default is not changed.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=nextgen-tradebot-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440   # 24 hours
# Encrypts stored secrets (per-user Alpaca keys). If empty, derived from JWT_SECRET_KEY.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# ── Email (verification + password reset) ─────────────────────────────────────
# Leave SMTP_HOST empty for local dev — emails are logged to the console instead
# of being sent, so verification/reset links are still usable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=NextGen TradeBot <no-reply@nextgentradebot.local>
# Public URL of the web app — used to build verify/reset links in emails
APP_BASE_URL=http://localhost:5173
# When true, users must verify their email before they can log in
REQUIRE_EMAIL_VERIFICATION=false

# ── News / Sentiment ──────────────────────────────────────────────────────────
# Free tier at https://newsapi.org — optional, falls back to yfinance headlines
NEWSAPI_KEY=

# ── Arabic sentiment (EGX) ────────────────────────────────────────────────────
# AraBERT (aubmindlab/bert-base-arabertv02) is downloaded automatically from
# HuggingFace on first use (~500 MB).  No key required.
# Set TRANSFORMERS_CACHE to a persistent volume to avoid re-downloading:
# TRANSFORMERS_CACHE=/data/models/hf_cache

# ── Alpaca (US paper trading) ─────────────────────────────────────────────────
# Sign up at https://alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── MT5 gateway (EGX / live broker) ──────────────────────────────────────────
MT5_GATEWAY_URL=http://51.21.209.128:8000
MT5_API_KEY=yassin2004
MT5_TIMEFRAME=M15

# ── Storage paths (defaults work out of the box) ─────────────────────────────
DATA_DIR=./data/datasets
MODELS_DIR=./data/models
RESULTS_DIR=./data/results

# ── Market UI ─────────────────────────────────────────────────────────────────
# When False (default): market page only shows real Yahoo Finance data.
# When True: falls back to demo/synthetic data when Yahoo Finance is unavailable.
MARKET_ALLOW_DEMO_FALLBACK=False

# ── Deployment / multi-user SaaS ──────────────────────────────────────────────
ENVIRONMENT=development
ALLOW_PUBLIC_REGISTER=true
# Include the deployed web origin(s). The Vercel frontend is already listed.
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173,https://nextgen-tradebot-self.vercel.app
# Set SEED_ADMIN=true to create default admin/admin123 in production
SEED_ADMIN=false
